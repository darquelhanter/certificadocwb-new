# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EVOLUTION_API_URL: URL pública do serviço Evolution API hospedado no Railway (sem barra final).
# Usada pelo server.ts (rota POST /api/submit-lead) para disparar a mensagem de WhatsApp direto, sem Make.com.
EVOLUTION_API_URL="https://SEU-APP.up.railway.app"

# EVOLUTION_API_KEY: API key definida nas variáveis de ambiente do serviço Evolution API no Railway.
EVOLUTION_API_KEY="SUA_API_KEY_AQUI"

# EVOLUTION_INSTANCE: Nome da instância conectada na Evolution API (opcional, padrão "SiteBot").
EVOLUTION_INSTANCE="SiteBot"

# PORT: Porta em que o servidor Express escuta (opcional, padrão 3000).
PORT="3000"

# ASAAS_API_KEY: Chave de API do Asaas (Configurações → Integrações → Chave de API).
# Usada pela rota POST /api/create-payment para gerar cobranças (Pix/Boleto/Cartão).
ASAAS_API_KEY="SUA_CHAVE_ASAAS_AQUI"

# ASAAS_ENV: "sandbox" (padrão, ambiente de teste) ou "production" (cobranças reais).
ASAAS_ENV="sandbox"

# DATABASE_URL: string de conexão Postgres (Neon), injetada automaticamente pela
# Vercel quando um banco Postgres é conectado ao projeto (aba "Storage").
# Para rodar localmente, copie o valor de "DATABASE_URL" das Environment Variables do projeto na Vercel.
DATABASE_URL="postgres://usuario:senha@host/banco?sslmode=require"

# ADMIN_PASSWORD: senha para acessar o Painel de Leads (/api/leads/*).
# Enviada pelo cliente no header x-admin-password em cada requisição administrativa.
ADMIN_PASSWORD="SUA_SENHA_AQUI"

# ASAAS_WEBHOOK_TOKEN: token de autenticação do webhook do Asaas.
# Configure o MESMO valor em: Asaas → Configurações → Integrações → Webhooks →
# "Token de Autenticação" (a URL do webhook é https://SEU-DOMINIO/api/asaas-webhook).
# Asaas envia esse token de volta no header "asaas-access-token" em cada chamada.
ASAAS_WEBHOOK_TOKEN="GERE_UM_TOKEN_ALEATORIO_AQUI"

# RESEND_API_KEY: chave de API da Resend (resend.com), usada para enviar os
# e-mails de confirmação de pagamento (cliente e admin) a partir do domínio
# certificadocwb.com.br, já verificado (DKIM/SPF/DMARC) na conta Resend.
RESEND_API_KEY="re_SUA_CHAVE_AQUI"

# WHATSAPP_WEBHOOK_SECRET: secret que protege o webhook de mensagens recebidas
# do WhatsApp (POST /api/whatsapp-webhook?secret=...). Configure a MESMA URL
# com esse secret como webhook da instância "CertificadoCWB" na Evolution API,
# escutando o evento MESSAGES_UPSERT.
WHATSAPP_WEBHOOK_SECRET="GERE_UM_SECRET_ALEATORIO_AQUI"

# ANTHROPIC_API_KEY: chave de API da Anthropic (console.anthropic.com),
# usada pelo assistente de IA que responde perguntas frequentes no WhatsApp.
ANTHROPIC_API_KEY="sk-ant-SUA_CHAVE_AQUI"

# META_CONVERSIONS_API_TOKEN: token de acesso da Conversions API do Meta, gerado em
# Gerenciador de Eventos → Pixel (1036956412492940) → Configurações → Conversions API.
# Usado para reportar o evento "Purchase" direto do servidor a cada pagamento confirmado
# (necessário porque o cliente paga na página do Asaas, fora do nosso site).
META_CONVERSIONS_API_TOKEN="SEU_TOKEN_CONVERSIONS_API_AQUI"
